# OpenAI API 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API 地址（可选，默认 OpenAI 官方）
# 使用 DeepSeek: https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型（可选，默认 gpt-4o）
# 使用 DeepSeek: deepseek-chat
# OPENAI_MODEL=gpt-4o

# 数据目录（可选，默认 data）
# DATA_DIR=data

# 启动时是否补生成当天内容（可选，默认 true）
# GENERATE_ON_STARTUP=true

# 定时生成 cron 表达式（可选，默认每天 00:05 执行一次）
# GENERATE_CRON=5 0 * * *

# 生成失败时的重试次数和重试间隔（可选）
# GENERATE_RETRY_COUNT=2
# GENERATE_RETRY_DELAY=30s

# 定时生成所用时区（可选，默认 Local）
# GENERATE_TIMEZONE=Asia/Shanghai

# 手动触发生成接口的鉴权 token（可选，不配置则接口关闭）
# MANUAL_TRIGGER_TOKEN=replace-with-a-long-random-secret

# HTTP 服务超时（可选）
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=120s
# SERVER_IDLE_TIMEOUT=120s
# SERVER_SHUTDOWN_TIMEOUT=15s

# Web 服务端口（可选，默认 18080）
# PORT=18080

# MCP 服务开关（可选，默认 false）
# MCP_ENABLED=false

# MCP 服务端口与路径（可选）
# MCP_PORT=18081
# MCP_PATH=/mcp

# MCP 访问 Bearer Token（启用 MCP 时必填）
# MCP_BEARER_TOKEN=replace-with-a-long-random-secret

# MCP readiness 探活参数（可选）
# MCP_READY_TIMEOUT=15s
# MCP_READY_RETRY_COUNT=3
# MCP_READY_RETRY_DELAY=10s

# MCP HTTP 服务超时（可选）
# MCP_SERVER_READ_TIMEOUT=15s
# MCP_SERVER_WRITE_TIMEOUT=300s
# MCP_SERVER_IDLE_TIMEOUT=120s
